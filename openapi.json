{
  "openapi": "3.1.0",
  "info": {
    "title": "Print.App API",
    "version": "2.0.0",
    "description": "Server-to-server API for Print.App integrations. Authenticate every request with a secret key: `Authorization: Bearer sk_…`. Never call it from a browser."
  },
  "servers": [
    {
      "url": "https://api.print.app",
      "description": "Production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "The account a secret key belongs to."
    },
    {
      "name": "Projects",
      "description": "Your customers' saved designs."
    }
  ],
  "paths": {
    "/v2/account": {
      "get": {
        "tags": [
          "Account"
        ],
        "operationId": "getAccount",
        "summary": "Get the account",
        "description": "Returns the account (domain) the secret key belongs to. The quickest way to check a key works.",
        "responses": {
          "200": {
            "description": "The account.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                },
                "example": {
                  "object": "account",
                  "id": "dom_01KA1WFS6BSCBQQV1H3EVTAXEA",
                  "hostnames": [
                    "shop.example.com"
                  ],
                  "created": "2026-03-02T10:15:00Z"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, revoked or expired secret key.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": true,
                  "code": "unauthorized",
                  "message": "Missing or invalid secret key. Send it as \"Authorization: Bearer sk_…\".",
                  "requestId": "FZn-uhymjoEEJow="
                }
              }
            }
          },
          "403": {
            "description": "The account is suspended for an unpaid invoice.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": true,
                  "code": "account_suspended",
                  "message": "This account is suspended. Settle the outstanding invoice in the Print.App dashboard.",
                  "requestId": "FZn-uhymjoEEJow="
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by the API gateway. Back off and retry. This response comes from the gateway, so its body is `{ \"message\": \"Too Many Requests\" }`, not the standard error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayError"
                },
                "example": {
                  "message": "Too Many Requests"
                }
              }
            }
          },
          "500": {
            "description": "Something failed on our side. Retry; quote the requestId to support if it persists.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": true,
                  "code": "internal_error",
                  "message": "Something went wrong on our side. Retry the request; if it keeps failing, contact support with the requestId.",
                  "requestId": "FZn-uhymjoEEJow="
                }
              }
            }
          }
        }
      }
    },
    "/v2/projects": {
      "get": {
        "tags": [
          "Projects"
        ],
        "operationId": "listProjects",
        "summary": "List projects",
        "description": "Lists your account's projects, most recently modified first. Page through them with `cursor`.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Projects per page."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The `nextCursor` of the previous page. Keep the other parameters the same between pages."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "draft",
                "saved",
                "submitted"
              ]
            },
            "description": "Only projects with this status."
          },
          {
            "name": "modifiedFrom",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Only projects last saved at or after this time: ISO-8601 (`2026-10-01T00:00:00Z`) or epoch milliseconds."
          },
          {
            "name": "modifiedTo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Only projects last saved at or before this time: ISO-8601 or epoch milliseconds."
          }
        ],
        "responses": {
          "200": {
            "description": "A page of projects.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectList"
                },
                "example": {
                  "object": "list",
                  "data": [
                    {
                      "object": "project",
                      "id": "project_2b6f1c9e-8d0a-4c3e-9f57-0c1d2e3f4a5b",
                      "title": "Business Card",
                      "status": "submitted",
                      "product": {
                        "id": "sku-123",
                        "ref": "cart-line-7f3a"
                      },
                      "userId": "customer-1001",
                      "userData": {
                        "id": "customer-1001",
                        "name": "Jane Doe",
                        "email": "jane@example.com"
                      },
                      "designId": "design_01J8Z9K2M3N4P5Q6R7S8T9V0W1",
                      "created": "2026-10-17T09:12:03Z",
                      "modified": "2026-10-17T09:20:41Z",
                      "pages": [
                        {
                          "index": 0,
                          "previewUrl": "https://d1p81tn8mwpox2.cloudfront.net/?k=s3%3A%2F%2Fapp-print-cdn%2Fcontent_a1.png&size=1000"
                        },
                        {
                          "index": 1,
                          "previewUrl": "https://d1p81tn8mwpox2.cloudfront.net/?k=s3%3A%2F%2Fapp-print-cdn%2Fcontent_b2.png&size=1000"
                        }
                      ],
                      "exports": {
                        "pdf": "https://pdf.print.app/project_2b6f1c9e-8d0a-4c3e-9f57-0c1d2e3f4a5b",
                        "png": "https://png.print.app/project_2b6f1c9e-8d0a-4c3e-9f57-0c1d2e3f4a5b",
                        "jpeg": "https://jpeg.print.app/project_2b6f1c9e-8d0a-4c3e-9f57-0c1d2e3f4a5b",
                        "tiff": "https://tiff.print.app/project_2b6f1c9e-8d0a-4c3e-9f57-0c1d2e3f4a5b"
                      }
                    }
                  ],
                  "hasMore": true,
                  "nextCursor": "eyJkb21haW5JZHgiOi…"
                }
              }
            }
          },
          "400": {
            "description": "A parameter is malformed; `param` names it.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": true,
                  "code": "invalid_request",
                  "message": "limit must be an integer from 1 to 100.",
                  "param": "limit",
                  "requestId": "FZn-uhymjoEEJow="
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, revoked or expired secret key.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": true,
                  "code": "unauthorized",
                  "message": "Missing or invalid secret key. Send it as \"Authorization: Bearer sk_…\".",
                  "requestId": "FZn-uhymjoEEJow="
                }
              }
            }
          },
          "403": {
            "description": "The account is suspended for an unpaid invoice.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": true,
                  "code": "account_suspended",
                  "message": "This account is suspended. Settle the outstanding invoice in the Print.App dashboard.",
                  "requestId": "FZn-uhymjoEEJow="
                }
              }
            }
          },
          "429": {
            "description": "Rate limited by the API gateway. Back off and retry. This response comes from the gateway, so its body is `{ \"message\": \"Too Many Requests\" }`, not the standard error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayError"
                },
                "example": {
                  "message": "Too Many Requests"
                }
              }
            }
          },
          "500": {
            "description": "Something failed on our side. Retry; quote the requestId to support if it persists.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": true,
                  "code": "internal_error",
                  "message": "Something went wrong on our side. Retry the request; if it keeps failing, contact support with the requestId.",
                  "requestId": "FZn-uhymjoEEJow="
                }
              }
            }
          }
        }
      }
    },
    "/v2/projects/{id}": {
      "get": {
        "tags": [
          "Projects"
        ],
        "operationId": "getProject",
        "summary": "Get a project",
        "description": "Returns one of your account's projects. A project that belongs to another account answers 404, exactly like one that doesn't exist, so a 200 proves the project is yours.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The `projectId` from the editor's `app:saved` event."
          }
        ],
        "responses": {
          "200": {
            "description": "The project.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                },
                "example": {
                  "object": "project",
                  "id": "project_2b6f1c9e-8d0a-4c3e-9f57-0c1d2e3f4a5b",
                  "title": "Business Card",
                  "status": "submitted",
                  "product": {
                    "id": "sku-123",
                    "ref": "cart-line-7f3a"
                  },
                  "userId": "customer-1001",
                  "userData": {
                    "id": "customer-1001",
                    "name": "Jane Doe",
                    "email": "jane@example.com"
                  },
                  "designId": "design_01J8Z9K2M3N4P5Q6R7S8T9V0W1",
                  "created": "2026-10-17T09:12:03Z",
                  "modified": "2026-10-17T09:20:41Z",
                  "pages": [
                    {
                      "index": 0,
                      "previewUrl": "https://d1p81tn8mwpox2.cloudfront.net/?k=s3%3A%2F%2Fapp-print-cdn%2Fcontent_a1.png&size=1000"
                    },
                    {
                      "index": 1,
                      "previewUrl": "https://d1p81tn8mwpox2.cloudfront.net/?k=s3%3A%2F%2Fapp-print-cdn%2Fcontent_b2.png&size=1000"
                    }
                  ],
                  "exports": {
                    "pdf": "https://pdf.print.app/project_2b6f1c9e-8d0a-4c3e-9f57-0c1d2e3f4a5b",
                    "png": "https://png.print.app/project_2b6f1c9e-8d0a-4c3e-9f57-0c1d2e3f4a5b",
                    "jpeg": "https://jpeg.print.app/project_2b6f1c9e-8d0a-4c3e-9f57-0c1d2e3f4a5b",
                    "tiff": "https://tiff.print.app/project_2b6f1c9e-8d0a-4c3e-9f57-0c1d2e3f4a5b"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, revoked or expired secret key.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": true,
                  "code": "unauthorized",
                  "message": "Missing or invalid secret key. Send it as \"Authorization: Bearer sk_…\".",
                  "requestId": "FZn-uhymjoEEJow="
                }
              }
            }
          },
          "403": {
            "description": "The account is suspended for an unpaid invoice.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
