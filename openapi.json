            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "A secret key from Print.App admin → Domains → Secret keys, sent as `Authorization: Bearer sk_…`. Server-side only."
      }
    },
    "headers": {
      "RequestId": {
        "description": "Identifies the request. Quote it when contacting support.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Account": {
        "title": "Account",
        "description": "The Print.App account (domain) a secret key belongs to.",
        "type": "object",
        "required": [
          "object",
          "id",
          "hostnames",
          "created"
        ],
        "additionalProperties": false,
        "properties": {
          "object": {
            "type": "string",
            "const": "account"
          },
          "id": {
            "type": "string",
            "description": "Your Domain Key (`dom_…`), the public key you use in the browser."
          },
          "hostnames": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The store hostnames registered for this account."
          },
          "created": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "examples": [
          {
            "object": "account",
            "id": "dom_01KA1WFS6BSCBQQV1H3EVTAXEA",
            "hostnames": [
              "shop.example.com"
            ],
            "created": "2026-03-02T10:15:00Z"
          }
        ]
      },
      "Error": {
        "title": "Error",
        "description": "Every error the API itself returns. Match on `code`; `message` is for people and may be reworded.",
        "type": "object",
        "required": [
          "error",
          "code",
          "message",
          "requestId"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "boolean",
            "const": true
          },
          "code": {
            "type": "string",
            "enum": [
              "unauthorized",
              "account_suspended",
              "invalid_request",
              "not_found",
              "route_not_found",
              "internal_error"
            ],
            "description": "`unauthorized` (401): missing, unknown, revoked or expired secret key. `account_suspended` (403): the account has an unpaid invoice. `invalid_request` (400): a parameter is malformed — see `param`. `not_found` (404): no such resource in your account. `route_not_found` (404): no such endpoint. `internal_error` (500): retry; contact support with the `requestId` if it persists."
          },
          "message": {
            "type": "string"
          },
          "param": {
            "type": "string",
            "description": "For `invalid_request`: the parameter at fault."
          },
          "requestId": {
            "type": "string",
            "description": "Also sent as the `x-request-id` header. Quote it when contacting support."
          }
        },
        "examples": [
          {
            "error": true,
            "code": "invalid_request",
            "message": "limit must be an integer from 1 to 100.",
            "param": "limit",
            "requestId": "FZn-uhymjoEEJow="
          }
        ]
      },
      "ProjectList": {
        "title": "ProjectList",
        "description": "A page of projects, most recently modified first.",
        "type": "object",
        "required": [
          "object",
          "data",
          "hasMore",
          "nextCursor"
        ],
        "additionalProperties": false,
        "properties": {
          "object": {
            "type": "string",
            "const": "list"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Project"
            }
          },
          "hasMore": {
            "type": "boolean",
            "description": "Whether another page may follow. A following page can come back empty when a `status` filter excludes the remaining projects."
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass as `cursor` to fetch the next page, with the same filters. `null` on the last page."
          }
        }
      },
      "Project": {
        "title": "Project",
        "description": "A customer's saved design.",
        "type": "object",
        "required": [
          "object",
          "id",
          "title",
          "status",
          "product",
          "userId",
          "userData",
          "designId",
          "created",
          "modified",
          "pages",
          "exports"
        ],
        "additionalProperties": false,
        "properties": {
          "object": {
            "type": "string",
            "const": "project"
          },
          "id": {
            "type": "string",
            "description": "The `projectId` from the editor's `app:saved` event."
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "saved",
              "submitted"
            ],
            "description": "`submitted`: the customer finished the design (the editor's submit). `saved`: saved for later. `draft`: autosaved, not yet saved by the customer."
          },
          "product": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true,
            "description": "Exactly the `product` object your page passed to `PrintAppClient` when the project was created — for example `{ id, ref }`. Use it to check the project was made for the product being ordered. It passes through the customer's browser, so treat it as the customer's claim about the page, not as proof."
          },
          "userId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The `userId` your page passed to `PrintAppClient`, if any."
          },
          "userData": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true,
            "description": "Customer details attached to the project by a store plugin or your page: `id`, `name`, `email`, `phone`, `info`.",
            "properties": {
              "id": {},
              "name": {
                "type": "string"
              },
              "firstName": {
                "type": "string"
              },
              "lastName": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "info": {
                "type": "string"
              }
            }
          },
          "designId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The design (template) the project was made from."
          },
          "created": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "modified": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Last save."
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "index",
                "previewUrl"
              ],
              "additionalProperties": false,
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "previewUrl": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "A preview image of the page."
                }
              }
            }
          },
          "exports": {
            "type": "object",
            "required": [
              "pdf",
              "png",
              "jpeg",
              "tiff"
            ],
            "additionalProperties": false,
            "description": "Print files, rendered on request from the project's current state.",
            "properties": {
              "pdf": {
                "type": "string"
              },
              "png": {
                "type": "string"
              },
              "jpeg": {
                "type": "string"
              },
              "tiff": {
                "type": "string"
              }
            }
          }
        },
        "examples": [
          {
            "object": "project",
            "id": "project_2b6f1c9e-8d0a-4c3e-9f57-0c1d2e3f4a5b",
            "title": "Business Card",
            "status": "submitted",
            "product": {
              "id": "sku-123",
